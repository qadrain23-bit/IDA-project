    {
      "id": 3,
      "title": "Postgres Database Size (MB)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(pg_database_size(current_database()) / 1e6, 1) AS mb"
        }
