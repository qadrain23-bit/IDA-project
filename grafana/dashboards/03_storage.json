  "panels": [
    {
      "id": 1,
      "title": "Rows in Staging (Postgres)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(row_count) AS rows FROM ops.storage_snapshot WHERE layer = 'staging_postgres' AND snapshot_at = (SELECT max(snapshot_at) FROM ops.storage_snapshot WHERE layer = 'staging_postgres')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
