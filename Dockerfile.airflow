FROM apache/airflow:2.11.0-python3.12
USER root
RUN mkdir -p /opt/pipeline && chown -R airflow: /opt/pipeline
USER airflow
COPY requirements.txt /tmp/requirements.txt
# long timeout + retries: slow or unstable connections to PyPI otherwise fail the build
RUN pip install --no-cache-dir --default-timeout=120 --retries 10 -r /tmp/requirements.txt
